# ==============================================================================
# Inerium Desktop Theme Template
# Copy this file to `~/.config/inerium/themes/<your-theme-id>.toml` or run:
#   inerium-theme new <your-theme-id>
#
# COLOR FORMATS ACCEPTED:
#   - HEX:       "#1e2029", "1e2029" (without hash), "#123" (3-digit)
#   - HEX+Alpha: "#1e2029cc", "#1238"
#   - RGB:       "rgb(30, 32, 41)"
#   - RGBA:      "rgba(30, 32, 41, 0.85)"
#   - CSS-4:     "rgb(30 32 41 / 85%)"
#
# AUTO-DERIVATION:
#   Fields marked "(optional)" can be omitted. The theme engine will automatically
#   compute balanced values (button backgrounds @ 16%, borders @ 35%, hover @ +8%,
#   active @ +15%, slider fill from accent_primary).
# ==============================================================================

[theme]
id = "my-custom-theme"               # Unique identifier (lowercase, hyphens only, e.g. "cyberpunk-2077")
name = "My Custom Theme"             # Human-readable title shown in menus and center
author = "Your Name"                 # Author attribution
upstream = "https://github.com/..."  # Optional upstream link
variant = "dark"                     # "dark" or "light" (controls GTK/Portal system theme switch)
license = "MIT"                      # License
description = "My custom desktop theme"

# ------------------------------------------------------------------------------
# Typography (Optional)
# Automatically configures GTK, Waybar, Rofi, Kitty, Mako, and desktop windows.
# Includes protective fallback chain to "JetBrainsMono Nerd Font" for icon glyphs.
# ------------------------------------------------------------------------------
[typography]
font_ui = "Inter"                    # Interface font (GTK, Waybar, menus)
font_mono = "JetBrainsMono Nerd Font"# Monospace font (Kitty terminal, code)
font_size = 10.0                     # Base UI font size

# ------------------------------------------------------------------------------
# Color Palette
# ------------------------------------------------------------------------------
[palette]
# Canvas and background layers
bg_canvas         = "#111216"        # Desktop backdrop, Waybar, and popup base background
bg_surface        = "#1e2029"        # Cards, dialogs, control center tiles
# bg_surface_alt    = "#17181f"      # (optional) Contrasting secondary surfaces / lists
# bg_surface_hover  = "#262935"      # (optional) Button and tile hover state
# bg_surface_active = "#2e3241"      # (optional) Active / pressed element state

# Typography & Text Contrast
text_heading      = "#e6e8ee"        # Bold headings, active window titles
text_primary      = "#cfd2dd"        # Default body text
# text_muted        = "#72778e"      # (optional) Secondary captions, placeholders
# text_subtle       = "#9ba0b4"      # (optional) Tertiary text, timestamps
# text_inverted     = "#111216"      # (optional) Text on bright accent badges

# Window borders & Hyprland outlines
border_subtle     = "rgba(147, 138, 169, 0.20)" # Inactive window borders and dividers
border_active     = "#938aa9"                   # Active window border
# border_active_secondary = "#938aa9"           # (optional) 2nd color for Hyprland border gradient

# Sliders in Control Center and popups
# slider_fill           = "#938aa9"  # (optional, defaults to accent_primary)
# slider_fill_secondary = "#e6c384"  # (optional, secondary slider fill, defaults to accent_amber)
# slider_trough         = "rgba(207, 210, 221, 0.10)" # (optional)
# slider_thumb          = "#e6e8ee"  # (optional, defaults to text_heading)

# Dominant theme accents
accent_primary    = "#938aa9"        # Primary system accent (buttons, focus, badges)
# accent_orange     = "#e6c384"      # (optional, defaults to accent_amber)

# Accent colors (Used for badges, highlights, status indicators, and graphs)
accent_green      = "#87a987"        # Wi-Fi active, success, toggles ON
# accent_green_bg   = "rgba(135, 169, 135, 0.16)"  # (optional, auto-derived)
# accent_green_border = "rgba(135, 169, 135, 0.35)" # (optional, auto-derived)

accent_blue       = "#7fb4ca"        # Bluetooth, links, informational chips
# accent_blue_bg    = "rgba(127, 180, 202, 0.16)"  # (optional, auto-derived)
# accent_blue_border = "rgba(127, 180, 202, 0.35)" # (optional, auto-derived)

accent_amber      = "#e6c384"        # Warnings, battery charging
# accent_amber_bg   = "rgba(230, 195, 132, 0.16)"  # (optional, auto-derived)
# accent_amber_border = "rgba(230, 195, 132, 0.35)"# (optional, auto-derived)

accent_red        = "#e46876"        # Errors, power off button, danger
# accent_red_bg     = "rgba(228, 104, 118, 0.16)"  # (optional, auto-derived)
# accent_red_border = "rgba(228, 104, 118, 0.35)"  # (optional, auto-derived)

accent_aqua       = "#7aa89f"        # Audio, secondary indicators
# accent_aqua_bg    = "rgba(122, 168, 159, 0.16)"  # (optional, auto-derived)
# accent_aqua_border = "rgba(122, 168, 159, 0.35)" # (optional, auto-derived)

accent_purple     = "#938aa9"        # Twilight amethyst / purple accent
# accent_purple_bg  = "rgba(147, 138, 169, 0.16)"  # (optional, auto-derived)
# accent_purple_border = "rgba(147, 138, 169, 0.35)"# (optional, auto-derived)

[display]
# Optional display color temperature via hyprsunset (e.g. 5500 for warm paper light, 6500 for standard)
temperature = 6500
