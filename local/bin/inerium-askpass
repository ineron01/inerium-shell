#!/usr/bin/env bash
# ==============================================================================
# inerium-askpass — Password prompt dialog styled in Inerium Dragon aesthetic
# Used as SUDO_ASKPASS / SSH_ASKPASS for system scripts and GUI requests
# ==============================================================================

is_ru() {
    local loc=""
    if [[ -f "$HOME/.config/locale.conf" ]]; then
        loc="$(grep -E '^LANG=' "$HOME/.config/locale.conf" 2>/dev/null | cut -d= -f2 | tr -d '"' || true)"
    fi
    [[ -z "$loc" ]] && loc="${LC_ALL:-${LANG:-}}"
    [[ "$loc" == ru* || "$loc" == RU* ]]
}

export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
if [[ -z "${WAYLAND_DISPLAY:-}" ]]; then
    for s in "$XDG_RUNTIME_DIR"/wayland-[0-9]*; do
        if [[ -S "$s" ]]; then
            export WAYLAND_DISPLAY="${s##*/}"
            break
        fi
    done
fi

default_prompt="Authentication required:"
if is_ru; then
    default_prompt="Требуется подтверждение пароля:"
fi

prompt="${1:-$default_prompt}"

# Clean prompt from prefixes and trailing colons
clean_prompt="$(echo "$prompt" | sed -e 's/^\[sudo\] //' -e 's/:$//')"

rofi -dmenu \
     -password \
     -no-fixed-num-lines \
     -p "󰌾 " \
     -mesg "$clean_prompt" \
     -theme "$HOME/.config/rofi/askpass.rasi"
