#!/usr/bin/env bash
set -euo pipefail

is_ru() {
    local loc=""
    if [[ -f "$HOME/.config/locale.conf" ]]; then
        loc="$(grep -E '^LANG=' "$HOME/.config/locale.conf" 2>/dev/null | cut -d= -f2 | tr -d '"' || true)"
    fi
    [[ -z "$loc" ]] && loc="${LC_ALL:-${LANG:-}}"
    [[ "$loc" == ru* || "$loc" == RU* ]]
}

# Directory for storing screenshots cache
CACHE_DIR="${HOME}/.cache/screenshots"
mkdir -p "$CACHE_DIR"

DATETIME=$(date +'%Y-%m-%d_%H-%M-%S')
HUMAN_DATE=$(date +'%Y-%m-%d %H:%M:%S')
FILENAME="screenshot_${DATETIME}.png"
FILEPATH="${CACHE_DIR}/${FILENAME}"

MODE="${1:-area}"

case "$MODE" in
    area)
        GEOM=$(slurp 2>/dev/null) || exit 0
        grim -g "$GEOM" "$FILEPATH"
        ;;
    fullscreen)
        grim "$FILEPATH"
        ;;
    *)
        GEOM=$(slurp 2>/dev/null) || exit 0
        grim -g "$GEOM" "$FILEPATH"
        ;;
esac

# Copy image to clipboard
wl-copy --type image/png < "$FILEPATH"

# Register screenshot metadata (date, time, filename) for clipboard previews
python3 - "$FILEPATH" "$FILENAME" "$HUMAN_DATE" <<'PYEOF' 2>/dev/null || true
import json, os, hashlib, sys
filepath = sys.argv[1]
filename = sys.argv[2]
human_date = sys.argv[3]
cache_dir = os.path.expanduser('~/.cache/cliphist')
os.makedirs(cache_dir, exist_ok=True)
meta_file = os.path.join(cache_dir, 'image-meta.json')
try:
    with open(filepath, 'rb') as f:
        img_bytes = f.read()
    h = hashlib.sha256(img_bytes).hexdigest()
    data = {}
    if os.path.exists(meta_file):
        try:
            with open(meta_file, 'r', encoding='utf-8') as f:
                data = json.load(f)
        except Exception:
            pass
    data[h] = {
        'filename': filename,
        'datetime': human_date,
        'path': filepath,
        'type': 'screenshot'
    }
    if len(data) > 100:
        data = dict(list(data.items())[-100:])
    with open(meta_file, 'w', encoding='utf-8') as f:
        json.dump(data, f, ensure_ascii=False, indent=2)
except Exception:
    pass
PYEOF

# Send notification; open editor on click
if is_ru; then
    ACTION=$(notify-send -a "Скриншот" \
        -i "$FILEPATH" \
        -t 6000 \
        --action="default=✏️ Открыть в редакторе" \
        --action="edit=✏️ Открыть в редакторе" \
        "Снимок экрана скопирован в буфер" \
        "${FILENAME}" 2>/dev/null || true)
else
    ACTION=$(notify-send -a "Screenshot" \
        -i "$FILEPATH" \
        -t 6000 \
        --action="default=✏️ Open in Editor" \
        --action="edit=✏️ Open in Editor" \
        "Screenshot copied to clipboard" \
        "${FILENAME}" 2>/dev/null || true)
fi

if [[ "$ACTION" == "default" || "$ACTION" == "edit" ]]; then
    mkdir -p "${HOME}/Pictures/Screenshots"
    if command -v satty &>/dev/null; then
        satty --filename "$FILEPATH" \
              --output-filename "${HOME}/Pictures/Screenshots/screenshot_%Y-%m-%d_%H-%M-%S.png" \
              --early-exit copy &
    elif command -v swappy &>/dev/null; then
        swappy -f "$FILEPATH" -o "${HOME}/Pictures/Screenshots/${FILENAME}" &
    fi
fi
