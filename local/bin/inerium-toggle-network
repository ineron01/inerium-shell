#!/usr/bin/env bash
# Smart Network Toggle for Waybar RMB
# If any wired Ethernet cable is connected (carrier == 1), toggle that interface.
# If no cable, toggle Wi-Fi radio.
set -euo pipefail

is_ru() {
    local loc=""
    if [[ -f "$HOME/.config/locale.conf" ]]; then
        loc="$(grep -E '^LANG=' "$HOME/.config/locale.conf" 2>/dev/null | cut -d= -f2 | tr -d '"' || true)"
    fi
    [[ -z "$loc" ]] && loc="${LC_ALL:-${LANG:-}}"
    [[ "$loc" == ru* || "$loc" == RU* ]]
}

ETH_IF=""
for dev in /sys/class/net/en* /sys/class/net/eth*; do
    [ -e "$dev" ] || continue
    if [ -f "$dev/carrier" ] && [ "$(cat "$dev/carrier" 2>/dev/null)" = "1" ]; then
        ETH_IF=$(basename "$dev")
        break
    fi
done

if [ -n "$ETH_IF" ]; then
    STATE="$(nmcli -t -f DEVICE,STATE dev 2>/dev/null | grep "^${ETH_IF}:" | cut -d: -f2 || true)"
    if [ "$STATE" = "connected" ]; then
        nmcli dev disconnect "$ETH_IF"
        if is_ru; then
            notify-send -a "Сеть" -i network-offline "Сеть Ethernet" "Кабель подключен, интерфейс $ETH_IF отключен"
        else
            notify-send -a "Network" -i network-offline "Ethernet Network" "Cable connected, interface $ETH_IF disconnected"
        fi
    else
        nmcli dev connect "$ETH_IF"
        if is_ru; then
            notify-send -a "Сеть" -i network-transmit-receive "Сеть Ethernet" "Интерфейс $ETH_IF подключен"
        else
            notify-send -a "Network" -i network-transmit-receive "Ethernet Network" "Interface $ETH_IF connected"
        fi
    fi
else
    WIFI_STATUS="$(nmcli radio wifi 2>/dev/null || true)"
    if [ "$WIFI_STATUS" = "enabled" ]; then
        nmcli radio wifi off
        if is_ru; then
            notify-send -a "Сеть" -i network-wireless-offline "Беспроводная сеть" "Wi-Fi модуль выключен"
        else
            notify-send -a "Network" -i network-wireless-offline "Wireless Network" "Wi-Fi radio disabled"
        fi
    else
        nmcli radio wifi on
        if is_ru; then
            notify-send -a "Сеть" -i network-wireless-signal-excellent "Беспроводная сеть" "Wi-Fi модуль включен"
        else
            notify-send -a "Network" -i network-wireless-signal-excellent "Wireless Network" "Wi-Fi radio enabled"
        fi
    fi
fi

# Notify network module via inerium-ctl with fallback to pkill
inerium-ctl notify network 2>/dev/null || pkill -SIGUSR1 inerium-network 2>/dev/null || true
