/**
 * Общая тема rofi — Inerium Desktop, в стиле Центра управления и попапов.
 * Подключается из config.rasi (лаунчер), clipboard.rasi и applet.rasi.
 **/

* {
    /* Fallback palette for older or unmigrated colors.rasi */
    green:        #87a987;
    green-soft:   rgba(135, 169, 135, 0.16);
    green-line:   rgba(135, 169, 135, 0.35);
    primary:      @green;
    primary-soft: @green-soft;
    primary-line: @green-line;
    font:         "JetBrainsMono Nerd Font 10.5";
}

@import "colors.rasi"

* {
    background-color: transparent;
    text-color: @fg;
}

window {
    width: 620px;
    border: 1px;
    border-color: @line;
    border-radius: 16px;
    background-color: @bg;
    padding: 14px;
}

mainbox {
    children: [ inputbar, message, listview ];
    spacing: 10px;
}

inputbar {
    children: [ prompt, entry ];
    spacing: 10px;
    padding: 10px 14px;
    border: 1px;
    border-color: @line-soft;
    border-radius: 12px;
    background-color: @surface;
}

prompt {
    text-color: @primary;
    vertical-align: 0.5;
}

entry {
    text-color: @fg-bright;
    placeholder-color: @muted;
    vertical-align: 0.5;
    cursor: text;
}

message {
    padding: 8px 12px;
    border-radius: 12px;
    background-color: @surface;
}
textbox { text-color: @muted; }

listview {
    columns: 1;
    lines: 7;
    spacing: 6px;
    /* Высота всегда на lines строк: окно не «прыгает», когда совпадений мало */
    fixed-height: true;
    scrollbar: false;
}

element {
    padding: 8px 12px;
    spacing: 12px;
    border: 1px;
    border-color: @line-soft;
    border-radius: 12px;
    background-color: @surface;
    text-color: @fg;
    cursor: pointer;
}

element normal.normal, element alternate.normal {
    background-color: @surface;
    text-color: @fg;
}

element normal.active, element alternate.active {
    background-color: @primary-soft;
    border-color: @primary-line;
    text-color: @fg-bright;
}

element normal.urgent, element alternate.urgent {
    text-color: @red;
}

element selected.normal, element selected.active, element selected.urgent {
    background-color: @primary-soft;
    border-color: @primary-line;
    text-color: @fg-bright;
}

element-icon {
    size: 30px;
    vertical-align: 0.5;
    background-color: transparent;
}

element-text {
    vertical-align: 0.5;
    background-color: transparent;
    text-color: inherit;
    highlight: bold;
}
