/**
 * Inerium Desktop — Askpass Theme (SUDO / SSH / подтверждение действий)
 * Наследует текущую цветовую палитру из inerium.rasi / colors.rasi.
 **/

@theme "~/.config/rofi/inerium.rasi"

window {
    width: 440px;
    border: 1px;
    border-color: @line-soft;
    border-radius: 16px;
    padding: 16px;
    background-color: @bg;
}

mainbox {
    children: [ message, inputbar ];
    spacing: 12px;
}

message {
    padding: 4px 8px;
    border: none;
    background-color: transparent;
}

textbox {
    text-color: @fg;
    horizontal-align: 0.5;
}

inputbar {
    children: [ prompt, entry ];
    padding: 10px 14px;
    border-radius: 10px;
    background-color: @surface;
    border: 1px;
    border-color: @line-soft;
}

prompt {
    text-color: @primary;
    margin: 0 8px 0 0;
    vertical-align: 0.5;
}

entry {
    text-color: @fg-bright;
    placeholder-color: @muted;
    vertical-align: 0.5;
    cursor: text;
}

