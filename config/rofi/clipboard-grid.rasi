configuration {
    show-icons: true;
    disable-history: true;
    hover-select: true;
    me-select-entry: "";
    me-accept-entry: "MousePrimary";
    scroll-method: 1;
}

@theme "~/.config/rofi/inerium.rasi"

/* Галерея скриншотов: тот же размер окна, что и буфер (680px), сетка 3x2, боковой слайдер */
window {
    width: 680px;
}

entry {
    placeholder: "Поиск в галерее скриншотов…";
}

listview {
    columns: 3;
    lines: 2;
    flow: horizontal;
    spacing: 10px;
    cycle: false;
    fixed-height: true;
    scrollbar: true;
    scrollbar-width: 6px;
}

scrollbar {
    handle-width: 6px;
    handle-color: @primary;
    border-radius: 4px;
    background-color: @line-soft;
    margin: 0px 0px 0px 8px;
}

element {
    orientation: vertical;
    padding: 10px 8px;
    spacing: 6px;
    border-radius: 12px;
}

element-icon {
    size: 120px;
    horizontal-align: 0.5;
    vertical-align: 0.5;
}

element-text {
    horizontal-align: 0.5;
    vertical-align: 0.5;
    font: "JetBrainsMono Nerd Font 9.5";
}
