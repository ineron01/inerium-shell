# Generated by inerium-theme for Ineron (author: ineron)
font=JetBrainsMono Nerd Font 10
width=360
background-color=#111216ff
text-color=#e1e3e8
border-color=#7e859b33
border-size=1
border-radius=16
padding=12,14
margin=8,8,0,8
outer-margin=4,0,0,0
icon-border-radius=10
max-icon-size=40
icons=1
actions=1
progress-color=over #938aa929
format=<b>%s</b>\n<span color="#9ea2af">%b</span>
default-timeout=5000
layer=overlay
anchor=top-right

history=0
max-history=0

[urgency=low]
border-color=#7e859b33
format=<span color="#9ea2af"><b>%s</b></span>\n<span color="#757985">%b</span>
default-timeout=3000

[urgency=normal]
default-timeout=5000

[urgency=high]
border-color=#c4746e
format=<span color="#c4746e"><b>%s</b></span>\n%b
default-timeout=0

[mode=dnd]
invisible=1

[mode=do-not-disturb]
invisible=1
