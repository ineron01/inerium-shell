#!/usr/bin/env bash
# Title: GitHub — вход, git push по HTTPS и подпись коммитов
set -euo pipefail
configured() { gh auth status >/dev/null 2>&1 && git config --global user.email >/dev/null; }
if [[ "${1:-}" == --check ]]; then configured; exit; fi

if ! gh auth status >/dev/null 2>&1; then
    echo "Сейчас появится код: откройте https://github.com/login/device (можно с телефона) и введите его."
    gh auth login -h github.com -p https -w
fi
gh auth setup-git
if ! git config --global user.email >/dev/null; then
    login="$(gh api user --jq .login)"
    id="$(gh api user --jq .id)"
    read -rp "Имя для коммитов [$login]: " name
    read -rp "Email для коммитов [$id+$login@users.noreply.github.com]: " email
    git config --global user.name "${name:-$login}"
    git config --global user.email "${email:-$id+$login@users.noreply.github.com}"
fi
configured
