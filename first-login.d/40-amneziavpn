#!/usr/bin/env bash
# Title: AmneziaVPN — добавить ключ подключения
set -euo pipefail
conf="$HOME/.config/AmneziaVPN.ORG/AmneziaVPN.conf"
# an empty server list serialises to a short value; any real server makes it long
configured() { [[ "$(grep -m1 '^serversList=' "$conf" 2>/dev/null | wc -c)" -gt 64 ]]; }
if [[ "${1:-}" == --check ]]; then configured; exit; fi

command -v AmneziaVPN >/dev/null || { echo "AmneziaVPN не установлен (пакет amneziavpn-bin)."; exit 1; }
echo "Открываю AmneziaVPN: вставьте ключ (vpn://...) или импортируйте файл, затем закройте окно приложения."
AmneziaVPN >/dev/null 2>&1 || true
configured || { echo "Сервер в AmneziaVPN не найден."; exit 1; }
