#!/usr/bin/env bash
# Title: Antigravity — вход в аккаунт Google
set -euo pipefail
configured() { [[ -s "$HOME/.gemini/jetski-standalone-oauth-token" ]]; }
if [[ "${1:-}" == --check ]]; then configured; exit; fi

command -v antigravity >/dev/null || { echo "Antigravity не установлен (пакет antigravity)."; exit 1; }
echo "Открываю Antigravity: войдите в аккаунт и вернитесь в это окно."
setsid -f antigravity >/dev/null 2>&1
read -rp "Enter — когда вход выполнен "
configured || { echo "Токен входа не найден в ~/.gemini."; exit 1; }
