#!/usr/bin/env bash
set -eo pipefail

case "${1:-}" in
    "status")
        echo "=== Статус сетевой изоляции ==="
        echo -n "Основная система (Хост / VPN): "
        curl -s --max-time 3 https://ifconfig.me 2>/dev/null || echo "нет связи"
        echo ""
        echo -n "Изолированная сеть (novpn / Прямой интернет): "
        if ip netns list | grep -qw "novpn"; then
            sudo ip netns exec novpn curl -s --max-time 3 https://ifconfig.me 2>/dev/null || echo "нет связи в novpn"
        else
            echo "служба novpn остановлена"
        fi
        echo ""
        ;;
    "restart"|"refresh")
        echo "Обновление маршрутов novpn под текущий физический интерфейс..."
        sudo /usr/local/bin/novpn-up
        ;;
    "stop"|"off")
        echo "Остановка novpn..."
        sudo systemctl stop novpn.service
        ;;
    "start"|"on")
        echo "Запуск novpn..."
        sudo systemctl start novpn.service
        ;;
    "help"|"-h"|"--help"|"")
        if [ -z "${1:-}" ]; then
            echo "Использование: novpn <команда> [параметры...]"
            echo "              novpn [status|refresh|on|off]"
            echo ""
            echo "Примеры:"
            echo "  novpn curl https://ifconfig.me"
            echo "  novpn google-chrome-stable --user-data-dir=~/.config/google-chrome-direct"
            echo "  novpn status"
            exit 1
        fi
        ;;
    *)
        exec sudo --preserve-env=DISPLAY,WAYLAND_DISPLAY,XDG_RUNTIME_DIR,DBUS_SESSION_BUS_ADDRESS,PULSE_SERVER,PIPEWIRE_RUNTIME_DIR /usr/local/bin/novpn-exec "$@"
        ;;
esac
