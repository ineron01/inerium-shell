#!/usr/bin/env bash
set -eo pipefail

is_ru() {
    local locale_conf="$HOME/.config/locale.conf"
    if [[ -f "$locale_conf" ]] && grep -qE '^LANG=ru' "$locale_conf"; then
        return 0
    fi
    [[ "${LANG:-}" =~ ^ru || "${LC_ALL:-}" =~ ^ru ]]
}

case "${1:-}" in
    "status")
        if is_ru; then
            echo "=== Статус сетевой изоляции ==="
            echo -n "Основная система (Хост / VPN): "
        else
            echo "=== Network Isolation Status ==="
            echo -n "Host System (VPN / Default): "
        fi
        curl -s --max-time 3 https://ifconfig.me 2>/dev/null || { if is_ru; then echo "нет связи"; else echo "no connection"; fi; }
        echo ""
        if is_ru; then
            echo -n "Изолированная сеть (novpn / Прямой интернет): "
        else
            echo -n "Isolated Network (novpn / Direct Internet): "
        fi
        if ip netns list | grep -qw "novpn"; then
            sudo ip netns exec novpn curl -s --max-time 3 https://ifconfig.me 2>/dev/null || { if is_ru; then echo "нет связи в novpn"; else echo "no connection in novpn"; fi; }
        else
            if is_ru; then echo "служба novpn остановлена"; else echo "novpn service stopped"; fi
        fi
        echo ""
        ;;
    "restart"|"refresh")
        if is_ru; then
            echo "Обновление маршрутов novpn под текущий физический интерфейс..."
        else
            echo "Refreshing novpn routes for active physical interface..."
        fi
        sudo /usr/local/bin/novpn-up
        ;;
    "stop"|"off")
        if is_ru; then
            echo "Остановка novpn..."
        else
            echo "Stopping novpn..."
        fi
        sudo systemctl stop novpn.service
        ;;
    "start"|"on")
        if is_ru; then
            echo "Запуск novpn..."
        else
            echo "Starting novpn..."
        fi
        sudo systemctl start novpn.service
        ;;
    "make-desktop"|"desktop"|"profile"|"make-profile")
        shift
        desktop_helper="/usr/local/bin/novpn-desktop"
        if [[ ! -x "$desktop_helper" ]]; then
            desktop_helper="$(dirname "$0")/novpn-desktop"
        fi
        if command -v "$desktop_helper" >/dev/null 2>&1 || [[ -x "$desktop_helper" ]]; then
            exec "$desktop_helper" "$@"
        else
            if is_ru; then
                echo "Ошибка: утилита novpn-desktop не найдена." >&2
            else
                echo "Error: novpn-desktop utility not found." >&2
            fi
            exit 1
        fi
        ;;
    "-b"|"--bg"|"--background"|"-d"|"--detach")
        shift
        if [ $# -eq 0 ]; then
            if is_ru; then
                echo "Ошибка: укажите команду для запуска в фоне." >&2
                echo "Пример: novpn -b prismalauncher" >&2
            else
                echo "Error: specify command to run in background." >&2
                echo "Example: novpn -b prismalauncher" >&2
            fi
            exit 1
        fi
        (nohup sudo /usr/local/bin/novpn-exec "$@" </dev/null >/dev/null 2>&1 &) 2>/dev/null
        exit 0
        ;;
    "help"|"-h"|"--help"|"")
        if is_ru; then
            echo "Использование: novpn <команда> [параметры...]"
            echo "              novpn [-b|--bg|-d|--detach] <команда> [параметры...]"
            echo "              novpn [status|refresh|on|off]"
            echo "              novpn make-desktop [браузер]"
            echo ""
            echo "Примеры:"
            echo "  novpn curl https://ifconfig.me"
            echo "  novpn -b prismalauncher"
            echo "  novpn --bg telegram-desktop"
            echo "  novpn make-desktop firefox"
            echo "  novpn status"
        else
            echo "Usage: novpn <command> [args...]"
            echo "       novpn [-b|--bg|-d|--detach] <command> [args...]"
            echo "       novpn [status|refresh|on|off]"
            echo "       novpn make-desktop [browser]"
            echo ""
            echo "Examples:"
            echo "  novpn curl https://ifconfig.me"
            echo "  novpn -b prismalauncher"
            echo "  novpn --bg telegram-desktop"
            echo "  novpn make-desktop firefox"
            echo "  novpn status"
        fi
        if [ -z "${1:-}" ]; then
            exit 1
        else
            exit 0
        fi
        ;;
    *)
        exec sudo /usr/local/bin/novpn-exec "$@"
        ;;
esac
