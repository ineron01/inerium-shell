#!/usr/bin/env bash
set -euo pipefail

is_ru() {
    local loc=""
    if [[ -f "/etc/locale.conf" ]]; then
        loc="$(grep -E '^LANG=' "/etc/locale.conf" 2>/dev/null | cut -d= -f2 | tr -d '"' || true)"
    fi
    [[ -z "$loc" ]] && loc="${LC_ALL:-${LANG:-}}"
    [[ "$loc" == ru* || "$loc" == RU* ]]
}

# 1. Enable IP forwarding on host
sysctl -w net.ipv4.ip_forward=1 >/dev/null

# 2. Dynamically determine physical interface and gateway (excluding VPN/virtual interfaces)
get_physical_default_route() {
    ip -4 route show default 2>/dev/null | while read -r line; do
        dev=$(echo "$line" | awk '{for(i=1;i<=NF;i++) if($i=="dev") print $(i+1)}')
        gw=$(echo "$line" | awk '{for(i=1;i<=NF;i++) if($i=="via") print $(i+1)}')
        metric=$(echo "$line" | awk '{for(i=1;i<=NF;i++) if($i=="metric") print $(i+1)}')
        [[ -z "$metric" ]] && metric=0
        if [[ -n "$dev" && -n "$gw" ]] && ! [[ "$dev" =~ ^(amn|tun|tap|wg|awg|tailscale|virbr|waydroid|docker|veth|br-|lo) ]]; then
            echo "$metric $gw $dev"
        fi
    done | sort -n -k1,1 | head -n1 | awk '{print $2, $3}'
}

read -r PHYS_GW PHYS_DEV < <(get_physical_default_route) || true

if [ -z "${PHYS_DEV:-}" ] || [ -z "${PHYS_GW:-}" ]; then
    if is_ru; then
        echo "Ошибка: Не удалось определить физический сетевой шлюз (eno1/wlp4s0)." >&2
    else
        echo "Error: Failed to determine physical network gateway (eno1/wlp4s0)." >&2
    fi
    exit 1
fi

if is_ru; then
    echo "Используется физический адаптер: $PHYS_DEV, шлюз: $PHYS_GW"
else
    echo "Using physical interface: $PHYS_DEV, gateway: $PHYS_GW"
fi

# 3. Create namespace if not exists
if ! ip netns list | grep -qw "novpn"; then
    ip netns add novpn
fi
ip -n novpn link set lo up

# Enable unprivileged ICMP ping inside namespace
ip netns exec novpn sysctl -w net.ipv4.ping_group_range="0 2147483647" >/dev/null 2>&1 || true

# 4. Create veth pair if not present
if ! ip link show veth-host >/dev/null 2>&1; then
    ip link add veth-host type veth peer name veth-novpn
    ip link set veth-novpn netns novpn
fi

# Configure host side
ip addr flush dev veth-host 2>/dev/null || true
ip addr add 10.200.1.1/24 dev veth-host
ip link set veth-host up

# Configure netns side
ip -n novpn addr flush dev veth-novpn 2>/dev/null || true
ip -n novpn addr add 10.200.1.2/24 dev veth-novpn
ip -n novpn link set veth-novpn up
ip -n novpn route del default 2>/dev/null || true
ip -n novpn route add default via 10.200.1.1 dev veth-novpn

# 5. Policy routing table 200 & leak prevention
# Delete existing rules to maintain idempotent priority ordering
ip rule del from 10.200.1.0/24 table 200 2>/dev/null || true
ip rule del from 10.200.1.0/24 unreachable priority 101 2>/dev/null || true

# Priority 100: direct traffic to table 200
ip rule add from 10.200.1.0/24 table 200 priority 100
# Priority 101: prevent fallthrough to main table / VPN tunnel (leak prevention)
ip rule add from 10.200.1.0/24 unreachable priority 101

# Update table 200 with current physical gateway
ip route flush table 200 2>/dev/null || true
ip route add default via "$PHYS_GW" dev "$PHYS_DEV" table 200

# 6. DNS in namespace (Yandex DNS + Google DNS fallback)
mkdir -p /etc/netns/novpn
cat << 'RESOLV' > /etc/netns/novpn/resolv.conf
nameserver 77.88.8.8
nameserver 77.88.8.1
nameserver 8.8.8.8
RESOLV

# 7. Firewall rules
iptables -D FORWARD -i veth-host -j ACCEPT 2>/dev/null || true
iptables -I FORWARD 1 -i veth-host -j ACCEPT

iptables -D FORWARD -o veth-host -m conntrack --ctstate RELATED,ESTABLISHED 2>/dev/null || true
iptables -I FORWARD 1 -o veth-host -m conntrack --ctstate RELATED,ESTABLISHED -j ACCEPT

# Clean up legacy and specific NAT rules
iptables -t nat -D POSTROUTING -s 10.200.1.0/24 ! -o amn0 -j MASQUERADE 2>/dev/null || true
iptables -t nat -D POSTROUTING -s 10.200.1.0/24 -o "$PHYS_DEV" -j MASQUERADE 2>/dev/null || true
while iptables -t nat -S POSTROUTING 2>/dev/null | grep -q -- "-s 10.200.1.0/24"; do
    rule_str="$(iptables -t nat -S POSTROUTING 2>/dev/null | grep -- "-s 10.200.1.0/24" | head -n1 | sed 's/^-A //')"
    [[ -n "$rule_str" ]] || break
    read -ra rule_args <<< "$rule_str"
    iptables -t nat -D "${rule_args[@]}" 2>/dev/null || break
done
iptables -t nat -I POSTROUTING 1 -s 10.200.1.0/24 -o "$PHYS_DEV" -j MASQUERADE

if is_ru; then
    echo "Изолированная прямая сеть (novpn) успешно активирована."
else
    echo "Isolated direct network (novpn) successfully activated."
fi
