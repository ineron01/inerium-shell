# Allow users to control MSI EC features and battery thresholds
SUBSYSTEM=="platform", DRIVER=="msi-ec", RUN+="/usr/bin/chmod 0666 /sys/devices/platform/msi-ec/cooler_boost /sys/devices/platform/msi-ec/shift_mode /sys/devices/platform/msi-ec/fan_mode /sys/devices/platform/msi-ec/super_battery"
SUBSYSTEM=="power_supply", KERNEL=="BAT1", RUN+="/usr/bin/chmod 0666 /sys/class/power_supply/BAT1/charge_control_end_threshold /sys/class/power_supply/BAT1/charge_control_start_threshold"
