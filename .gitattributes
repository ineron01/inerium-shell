# Enforce LF endings across all text files
* text=auto eol=lf

# Explicit text sources
*.rs text eol=lf
*.lua text eol=lf
*.sh text eol=lf
*.py text eol=lf
*.fish text eol=lf
*.rasi text eol=lf
*.css text eol=lf
*.json text eol=lf
*.jsonc text eol=lf
*.toml text eol=lf
*.md text eol=lf
*.conf text eol=lf

# Binary media assets
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.onnx binary
*.tar.gz binary
